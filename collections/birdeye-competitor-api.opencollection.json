        {
          "info": {
            "name": "Get Competitor Business",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.birdeye.com/v1/business/:EnterpriseBusinessNumber/child",
            "params": [
              {
                "name": "EnterpriseBusinessNumber",
                "value": "231123123",
                "type": "path",
                "description": "Enterprise Business id."
              },
              {
                "name": "isCompetitor",
                "value": "true",
                "type": "query",
                "description": "True for get competitor business of Enterprise Business and False for get Child Business of Enterprise Business."
              }
            ]
          },
          "docs": "Get Competitor Business"
        },
        {
