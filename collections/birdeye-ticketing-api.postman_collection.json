          "name": "Get All Ticket Data",
          "request": {
            "name": "Get All Ticket Data",
            "description": {},
            "url": {
              "path": [
                "v1",
                "ticket",
                ":businessNumber",
                "get",
                "all"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "",
                  "value": "null"
                },
                {
                  "disabled": false,
                  "key": "op",
                  "value": "<number>",
                  "description": "(Required) Possible values are: [1] will display ticket count only, [3] will display all the data of the ticket. Default value - 3."
                },
                {
                  "disabled": false,
                  "key": "sIndex",
                  "value": "<number>",
                  "description": "(Required) Start index of the response. Default value - 0"
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "<number>",
                  "description": "(Required) Number of tickets want to get in the response. Default value - 25"
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<number>",
                  "description": "(Required) Sort options, Possible values [2] will sort on the basis of ticket creation date. [3] will sort on the basis of characters of business aliases. Default value 2."
                },
                {
                  "disabled": false,
                  "key": "sortOrder",
                  "value": "<number>",
                  "description": "(Required) Sort Order [0] will sort the data in ascending order. [1] this will sort the data in descending order. Default value - 1"
