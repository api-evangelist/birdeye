{
  "opencollection": "1.0.0",
  "info": {
    "name": "Birdeye Aggregation Subscription API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscription",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.birdeye.com/v1/subscriptions/subscribe",
            "params": [
              {
                "name": "businessId",
                "value": "1234567890",
                "type": "query",
                "description": "Account business number."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create subscription"
        },
        {
          "info": {
            "name": "Unsubscribe subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.birdeye.com/v1/subscriptions/unsubscribe/:subscriptionId",
            "params": [
              {
                "name": "subscriptionId",
                "value": "tyhjwvbtys56782hbjsAGH",
                "type": "path"
              },
              {
                "name": "businessId",
                "value": "1234567890",
                "type": "query",
                "description": "Account business number."
              }
            ]
          },
          "docs": "Unsubscribe subscription"
        }
      ]
    }
  ],
  "bundled": true
}